# 复制为 .env 后填写，本地 npm run dev 会自动加载。
# 线上请在 Vercel 项目 → Settings → Environment Variables 里配置同样的键。

# ---------- 云端存储（Upstash Redis / Vercel KV）----------
# 不配置时：作品页只读、访客数走 localStorage、股票同步走 localStorage
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---------- 联系表单发信（SMTP）----------
SMTP_USER=
SMTP_PASS=
CONTACT_TO=

# ---------- 管理口令 ----------
WORKS_DELETE_PASSWORD=
NOTE_PASSWORD=

# ---------- 持仓截图识别（任选其一）----------
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=

# ---------- 店铺监控 cron（api/shop-monitor.js）----------
SP_API_CLIENT_ID=
SP_API_CLIENT_SECRET=
SP_API_REFRESH_TOKEN=
SP_API_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM=
EMAIL_TO=
EMAIL_AUTH=
